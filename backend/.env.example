# ── AI Sherpa 환경 변수 ──
# 이 파일을 .env로 복사한 후 값을 수정하세요.
# .env 파일은 절대 Git에 커밋하지 않습니다.

DEBUG=true
DB_URL=sqlite:///ai_sherpa.db
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
# CPU 추론(GPU 미사용) 환경: 응답 토큰 축소 + 대기 여유. GPU 면 NUM_PREDICT 상향 가능.
LLM_TIMEOUT=300
LLM_NUM_PREDICT=180
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PERSIST_DIR=./chroma_data
