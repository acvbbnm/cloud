    "T_evaluate": {
      "type": "terminal",
      "action": "evaluate_hypothesis",
      "rules": [
        {
          "condition": "max_score >= weights.thresholds.auto_skip_tree && gap_to_2nd >= weights.thresholds.gap_to_2nd",
          "outcome": "auto_confirm",
          "message": "단일 사고유형 자동 확정"
        },
        {
          "condition": "max_score >= weights.thresholds.high_confidence && gap_to_2nd < weights.thresholds.gap_to_2nd",
          "outcome": "propose_composite",
          "message": "복합 사고유형 제시 — 메인 + 부 사고유형"
        },
        {
          "condition": "max_score >= weights.thresholds.high_confidence",
          "outcome": "propose_single",
          "message": "단일 사고유형 제시 (사용자 수락 필요)"
        },
        {
          "condition": "max_score < weights.thresholds.high_confidence",
          "outcome": "continue_or_skip",
          "message": "임계값 미달 — 추가 단서 입력 또는 UNCLASSIFIED 진행"
        }
      ]
    }
